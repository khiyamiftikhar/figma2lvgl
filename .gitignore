sdkconfig.*
!sdkconfig.defaults
!sdkconfig.defaults.*
managed_components/
.vscode/
dump_repo.py
# Text dumps at the repo root only. A repo-wide *.txt would also hide new
# CMakeLists.txt and requirements.txt files.
/*.txt
